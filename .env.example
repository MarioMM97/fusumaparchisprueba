# Clave de Vercel AI Gateway (https://vercel.com/dashboard -> AI Gateway -> API keys).
# En local es necesaria; desplegado en Vercel también funciona con OIDC sin clave.
AI_GATEWAY_API_KEY=

# Opcional: cambia el modelo de cada personaje (formato "proveedor/modelo" del catálogo del Gateway)
# MODEL_YELLOW=anthropic/claude-haiku-5.5
# MODEL_BLUE=openai/gpt-5.4-nano
# MODEL_RED=anthropic/claude-sonnet-5.5
# MODEL_GREEN=openai/gpt-6-luna